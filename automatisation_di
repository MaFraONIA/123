import pandas as pd
from openpyxl import load_workbook
from pathlib import Path
import shutil

# =====================================================================
# PARAMÈTRES
# =====================================================================
fichier_historique = "U:/DG/DGDR/50.RISQUES FINANCIERS/550. Pilotage et Innovation/A_BASES/BDT/2_DP-DCB-DI/DataBrutes/31_08_2026/Portefeuille_DI_30_06_2026.xlsx"
dossier_destination = "U:/DG/DGDR/50.RISQUES FINANCIERS/550. Pilotage et Innovation/A_BASES/BDT/2_DP-DCB-DI/DataBrutes/"
# =====================================================================
# RÉCUPÉRATION DE LA DATE D'ARRÊTÉ
# =====================================================================
date_arrete = pd.to_datetime(reporting["Date arrêté"].iloc[0], dayfirst=True)
date_str = date_arrete.strftime("%d_%m_%Y")
nom_fichier_final = f"{dossier_destination}Portefeuille_DI_{date_str}.xlsx"

# =====================================================================
# COPIE DU FICHIER HISTORIQUE VERS UN NOUVEAU FICHIER
# =====================================================================
# 1. Copier le fichier historique vers le fichier final (pour conserver les formules)
shutil.copy2(fichier_historique, nom_fichier_final)

# 2. Charger le nouveau fichier et ajouter la feuille de reporting
wb_final = load_workbook(nom_fichier_final)

# 3. Créer une nouvelle feuille pour le reporting
with pd.ExcelWriter(
    nom_fichier_final,
    engine="openpyxl",
    mode="a",  # Mode "append" pour ajouter une feuille
    if_sheet_exists="replace"  # Remplacer si la feuille existe déjà
) as writer:
    reporting.to_excel(
        writer,
        sheet_name=date_str,
        index=False
    )

