def get_departement(code_postal):
    if code_postal.startswith('2A'):
        return 'Corse-du-Sud'
    elif code_postal.startswith('2B'):
        return 'Haute-Corse'
    elif code_postal.startswith('20'):
        return 'Corse'
    code_departement = code_postal[:3] if code_postal.startswith(('97', '98', '99')) else code_postal[:2]
    departement = departements.get(code_departement, 'Inconnu')
    return departement

