            df_bdt.loc[df_bdt['Identifiant emprunteur'] == ref_tiers, 'Motif Defaut / SS'] = choisir_motif(row)
            df_bdt.loc[df_bdt['Identifiant emprunteur'] == ref_tiers, 'Date entrée Defaut SS'] = row['Date comité entrée DEFAUT / SS SURVEILLANCE']
            df_bdt.loc[df_bdt['Identifiant emprunteur'] == ref_tiers, 'GAPD'] = row['GAPD']
        else:
            # Ajouter une nouvelle ligne
            nouvelle_ligne = {
                'Identifiant emprunteur': ref_tiers,
                'Direction': 'DCB',
                'Ressources': 'SG',
                "Produit" : 'Crédit',
                'Date': df_bdt['Date'].iloc[0],  # Utiliser la date de la BDT
                'Libellé court emprunteur': row['Libellé client'],
                'Structure':row['DDFIP / DRFIP'],
                'Libellé catégorie emprunteur': row['Catégorie client'],
                'DR': row['DR'],
                'GAPD': row['GAPD'],
                'Etat du tiers': row['Statut du tiers post comité M8 2026'],
                'Motif Defaut / SS': choisir_motif(row),
                'Date entrée Defaut SS': row['Date comité entrée DEFAUT / SS SURVEILLANCE']
            }
            nouvelles_lignes.append(pd.DataFrame([nouvelle_ligne]))
            
    # Concaténer les nouvelles lignes avec le DataFrame existant
    if nouvelles_lignes:
        nouvelles_lignes_df = pd.concat(nouvelles_lignes, ignore_index=True)
        start_index = len(df_bdt)
        df_bdt = pd.concat([df_bdt, nouvelles_lignes_df], ignore_index=True)
